# Optional server-only provider credentials. Never use NEXT_PUBLIC_ for secrets.
LL2_API_KEY=
NASA_API_KEY=
YOUTUBE_DATA_API_KEY=
YOUTUBE_DAILY_LOOKUP_BUDGET=25

# Optional compatible mirror for the archived r/SpaceX API. Current launch
# data is supplied by Launch Library 2 when this is unset.
SPACEX_API_BASE_URL=

# Optional xAI fallback for recent official @SpaceX mission updates.
# LaunchWatch uses provider launch data for facts; xAI is enrichment only.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_DAILY_LOOKUP_BUDGET=4

# Use either the bearer token or the complete OAuth 1.0a set.
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CONSUMER_KEY=
X_CONSUMER_KEY_SECRET=
